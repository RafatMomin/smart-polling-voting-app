<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="#F4F0FA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPolls"
        style="@style/Widget.Material3.Toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#6366F1"
        app:title="Polls"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white"
        app:navigationIconTint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroupPollFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarPolls"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAll"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textAllCaps="false"
            android:checked="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMine"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Polls"
            android:textAllCaps="false" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Search polls"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="#6B7280"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#A5B4FC"
        app:boxStrokeWidthFocused="2dp"
        app:layout_constraintTop_toBottomOf="@id/toggleGroupPollFilter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:singleSelection="true"
        app:layout_constraintTop_toBottomOf="@id/tilSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTypeAll"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Types"
            app:chipBackgroundColor="@color/mtrl_btn_transparent_bg_color"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTypeYesNo"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yes/No" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTypeRating"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTypeMCQ"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MCQ" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipTypeRanking"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ranking" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupVisibility"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="8dp"
        app:singleSelection="true"
        app:layout_constraintTop_toBottomOf="@id/chipGroupType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVisAll"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Visibility" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVisPublic"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Public" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVisPrivate"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Private" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPolls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="88dp"
        android:overScrollMode="always"
        app:layout_constraintTop_toBottomOf="@id/chipGroupVisibility"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No polls yet"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/recyclerPolls"
        app:layout_constraintBottom_toBottomOf="@id/recyclerPolls"
        app:layout_constraintStart_toStartOf="@id/recyclerPolls"
        app:layout_constraintEnd_toEndOf="@id/recyclerPolls" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:indeterminateTint="#6366F1"
        app:layout_constraintTop_toTopOf="@id/recyclerPolls"
        app:layout_constraintBottom_toBottomOf="@id/recyclerPolls"
        app:layout_constraintStart_toStartOf="@id/recyclerPolls"
        app:layout_constraintEnd_toEndOf="@id/recyclerPolls" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Create poll"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        app:backgroundTint="#6366F1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Open Chatbot"
        app:srcCompat="@drawable/ic_chat_24"
        app:tint="@android:color/white"
        app:backgroundTint="#F97316"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
